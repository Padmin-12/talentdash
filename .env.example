# TalentDash — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Pooled connection (used by the app for all queries)
# Get this from: neon.tech → Your Project → Connection Details → Pooled connection
DATABASE_URL="postgresql://user:password@ep-xxx-yyy.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection (used by Prisma for migrations only)
# Get this from: neon.tech → Your Project → Connection Details → Direct connection
DIRECT_URL="postgresql://user:password@ep-xxx-yyy.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
